<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
		https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.scijava</groupId>
		<artifactId>pom-scijava</artifactId>
		<version>38.0.1</version>
		<relativePath />
	</parent>

	<groupId>loci</groupId>
	<artifactId>fiji-curvealign</artifactId>
	<version>0.1.0-SNAPSHOT</version>

	<name>Fiji CurveAlign</name>
	<description>Fiji plugin that runs tme-quant CurveAlign workflows through Appose.</description>
	<url>https://github.com/uw-loci/fiji-curvealign</url>
	<inceptionYear>2026</inceptionYear>
	<organization>
		<name>LOCI</name>
		<url>https://loci.wisc.edu/</url>
	</organization>
	<licenses>
		<license>
			<name>MIT License</name>
			<distribution>repo</distribution>
		</license>
	</licenses>

	<developers>
		<developer>
			<id>loci</id>
			<name>LOCI</name>
			<url>https://loci.wisc.edu/</url>
		</developer>
	</developers>
	<contributors>
		<contributor>
			<name>LOCI</name>
		</contributor>
	</contributors>

	<mailingLists>
		<mailingList>
			<name>Image.sc Forum</name>
			<archive>https://forum.image.sc/</archive>
		</mailingList>
	</mailingLists>

	<ciManagement>
		<system>GitHub Actions</system>
		<url>https://github.com/uw-loci/fiji-curvealign/actions</url>
	</ciManagement>

	<scm>
		<connection>scm:git:https://github.com/uw-loci/fiji-curvealign</connection>
		<developerConnection>scm:git:git@github.com:uw-loci/fiji-curvealign</developerConnection>
		<tag>HEAD</tag>
		<url>https://github.com/uw-loci/fiji-curvealign</url>
	</scm>
	<issueManagement>
		<system>GitHub Issues</system>
		<url>https://github.com/uw-loci/tme-quant/issues/66</url>
	</issueManagement>

	<properties>
		<license.licenseName>mit</license.licenseName>
		<license.copyrightOwners>Board of Regents of the University of
Wisconsin-Madison.</license.copyrightOwners>
		<maven.compiler.source>21</maven.compiler.source>
		<maven.compiler.target>21</maven.compiler.target>
		<maven.compiler.release>21</maven.compiler.release>
		<scijava.jvm.version>21</scijava.jvm.version>
	</properties>

	<build>
		<plugins>
			<plugin>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<!--
					Fiji discovers @Plugin commands from META-INF/json.
					Putting the processor on the processor path keeps that
					index when javac no longer scans the classpath (JDK 23+).
					pom-scijava 38 does not set -proc:full for those JDKs.
					-->
					<annotationProcessorPaths>
						<path>
							<groupId>org.scijava</groupId>
							<artifactId>scijava-common</artifactId>
							<version>${scijava-common.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<repositories>
		<repository>
			<id>scijava.public</id>
			<url>https://maven.scijava.org/content/groups/public</url>
		</repository>
	</repositories>

	<dependencies>
		<!-- ImageJ2 command API. Fiji already provides this at runtime. -->
		<dependency>
			<groupId>net.imagej</groupId>
			<artifactId>imagej</artifactId>
		</dependency>

		<dependency>
			<groupId>junit</groupId>
			<artifactId>junit</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>
</project>
