<?xml version='1.0' encoding='UTF-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.scijava</groupId>
    <artifactId>pom-scijava</artifactId>
    <version>45.1.0</version>
    <relativePath />
  </parent>
  <groupId>org.loci</groupId>
  <artifactId>fiji-curvealign</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <name>CurveAlign for Fiji</name>
  <description>Fiji commands for tme-quant through Appose.</description>
  <url>https://github.com/uw-loci/fiji-curvealign</url>
  <inceptionYear>2026</inceptionYear>
  <organization>
    <name>Eliceiri Lab</name>
    <url>https://loci.wisc.edu/</url>
  </organization>
  <licenses>
    <license>
      <name>Simplified BSD License</name>
      <distribution>repo</distribution>
    </license>
  </licenses>
  <developers>
    <developer>
      <id>uw-loci</id>
      <name>Eliceiri Lab developers</name>
      <url>https://github.com/uw-loci</url>
    </developer>
  </developers>
  <contributors>
    <contributor>
      <name>CurveAlign for Fiji developers</name>
      <url>https://github.com/uw-loci/fiji-curvealign/graphs/contributors</url>
    </contributor>
  </contributors>
  <mailingLists>
    <mailingList>
      <name>Image.sc Forum</name>
      <archive>https://forum.image.sc/tag/fiji</archive>
    </mailingList>
  </mailingLists>
  <scm>
    <connection>scm:git:https://github.com/uw-loci/fiji-curvealign</connection>
    <developerConnection>scm:git:git@github.com:uw-loci/fiji-curvealign</developerConnection>
    <tag>HEAD</tag>
    <url>https://github.com/uw-loci/fiji-curvealign</url>
  </scm>
  <issueManagement>
    <system>github.com</system>
    <url>https://github.com/uw-loci/fiji-curvealign/issues</url>
  </issueManagement>
  <ciManagement>
    <system>GitHub Actions</system>
    <url>https://github.com/uw-loci/fiji-curvealign/actions</url>
  </ciManagement>
  <properties>
    <license.licenseName>bsd_2</license.licenseName>
    <license.copyrightOwners>CurveAlign for Fiji developers.</license.copyrightOwners>
    <license.projectName>Fiji integration for tme-quant workflows.</license.projectName>
    <releaseProfiles>sign,deploy-to-scijava</releaseProfiles>
    <scijava.jvm.version>17</scijava.jvm.version>
    <scijava.jvm.build.version>[17,)</scijava.jvm.build.version>
  </properties>
  <repositories>
    <repository>
      <id>scijava.public</id>
      <url>https://maven.scijava.org/content/groups/public</url>
    </repository>
  </repositories>
  <dependencies>
    <dependency>
      <groupId>net.imagej</groupId>
      <artifactId>imagej</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apposed</groupId>
      <artifactId>appose</artifactId>
      <version>0.10.0</version>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <configuration>
          <mainClass>org.loci.curvealign.Main</mainClass>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>license-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>default-cli</id>
            <configuration>
              <includes>
                <include>**/*.java</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>